// Handle unknown commands
bot.on('message', (msg) => {
  const text = msg.text;
  if (text && text.startsWith('/') && !text.match(/^\/(start|stop|balance|debts|total|progress|add|pay|delete|report|stats|help)/)) {
    bot.sendMessage(msg.chat.id, '❌ Невідома команда. Використовуйте /help для списку команд.');
  }
});

// ===== LISTEN FOR FIREBASE CHANGES =====
// Send notifications when debts are updated from web app
debtsRef.on('child_changed', async (snapshot) => {
  const debt = snapshot.val();
  const remain = debt.value - debt.paid;
  const percent = Math.round((debt.paid / debt.value) * 100);
  
  let emoji = debt.paid > 0 ? '💰' : '📉';
  if (percent === 100) emoji = '🎉';
  
  let message = `${emoji} <b>Зміну боргу "${debt.name}"</b>\n\n`;
  message += `Сплачено: ${formatMoney(debt.paid)} (${percent}%)\n`;
  message += `Залишок: ${formatMoney(remain)}`;
  
  if (percent === 100) {
    message += `\n\n✅ Борг повністю погашено!`;
  }
  
  await notifyAll(message);
});

debtsRef.on('child_added', async (snapshot) => {
  const debt = snapshot.val();
  // Don't notify for initial data load
  if (Date.now() - debt.created < 5000) {
    const message = `➕ <b>Новий борг додано</b>\n\nНазва: ${debt.name}\nСума: ${formatMoney(debt.value)}`;
    await notifyAll(message);
  }
});

debtsRef.on('child_removed', async (snapshot) => {
  const debt = snapshot.val();
  const message = `🗑️ <b>Борг видалено</b>\n\nНазва: ${debt.name}\nСума: ${formatMoney(debt.value)}`;
  await notifyAll(message);
});

