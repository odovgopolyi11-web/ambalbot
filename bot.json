// Initialize bot
const bot = new TelegramBot(BOT_TOKEN, { polling: true });

console.log('🤖 Telegram bot started!');

// ===== HELPER FUNCTIONS =====

// Format currency
function formatMoney(amount) {
  return amount.toLocaleString('uk-UA') + ' ₴';
}

// Get all debts
async function getDebts() {
  const snapshot = await debtsRef.once('value');
  const debtsObj = snapshot.val() || {};
  return Object.keys(debtsObj).map(k => ({ id: k, ...debtsObj[k] }));
}

// Calculate balance
async function getBalance() {
  const debts = await getDebts();
  const totalDebt = debts.reduce((sum, d) => sum + d.value, 0);
  const paid = debts.reduce((sum, d) => sum + d.paid, 0);
  return -totalDebt + paid;
}

// Check if user is subscribed
async function isSubscribed(chatId) {
  const snapshot = await subscribersRef.child(chatId.toString()).once('value');
  return snapshot.exists();
}

// Subscribe user
async function subscribe(chatId, userData) {
  await subscribersRef.child(chatId.toString()).set({
    chatId: chatId,
    firstName: userData.first_name || '',
    username: userData.username || '',
    subscribedAt: Date.now()
  });
}

// Unsubscribe user
async function unsubscribe(chatId) {
  await subscribersRef.child(chatId.toString()).remove();
}

// Get all subscribers
async function getAllSubscribers() {
  const snapshot = await subscribersRef.once('value');
  const subscribers = snapshot.val() || {};
  return Object.keys(subscribers).map(k => subscribers[k].chatId);
}

// Send notification to all subscribers
async function notifyAll(message) {
  const subscribers = await getAllSubscribers();
  for (const chatId of subscribers) {
    try {
      await bot.sendMessage(chatId, message, { parse_mode: 'HTML' });
    } catch (error) {
      console.error(`Failed to send to ${chatId}:`, error.message);
    }
  }
}

// ===== BOT COMMANDS =====

// /start - Subscribe to notifications
bot.onText(/\/start/, async (msg) => {
  const chatId = msg.chat.id;
  const user = msg.from;
  
  await subscribe(chatId, user);
  
  const welcomeMessage = `
🎉 <b>Вітаю в системі фінансового обліку!</b>

✅ Ви підписані на сповіщення

<b>📋 Доступні команди:</b>

<b>📊 Інформація:</b>
/balance - Поточний баланс
/debts - Список всіх боргів
/total - Загальна сума боргів
/progress - Прогрес виплат

<b>🔧 Управління:</b>
/add Назва Сума - Додати борг
/pay Назва Сума - Оплатити частину
/delete Назва - Видалити борг

<b>📈 Аналітика:</b>
/report - Повний звіт
/stats - Статистика

<b>⚙️ Налаштування:</b>
/stop - Відписатися від сповіщень
/help - Довідка по командах
`;
  
  bot.sendMessage(chatId, welcomeMessage, { parse_mode: 'HTML' });
});

// /stop - Unsubscribe
bot.onText(/\/stop/, async (msg) => {
  const chatId = msg.chat.id;
  await unsubscribe(chatId);
  bot.sendMessage(chatId, '😢 Ви відписалися від сповіщень.\n\nДля повторної підписки напишіть /start');
});

// /balance - Current balance
bot.onText(/\/balance/, async (msg) => {
  const chatId = msg.chat.id;
  
  try {
    const balance = await getBalance();
    const emoji = balance < 0 ? '📉' : balance === 0 ? '⚖️' : '📈';
    const phase = balance < 0 ? 'Закриття боргів' : balance === 0 ? 'Нульовий баланс' : 'Накопичення';
    
    const message = `
${emoji} <b>Поточний баланс</b>

💰 Баланс: <b>${formatMoney(balance)}</b>
📊 Фаза: ${phase}
`;
    
    bot.sendMessage(chatId, message, { parse_mode: 'HTML' });
  } catch (error) {
    bot.sendMessage(chatId, '❌ Помилка отримання балансу');
  }
});

// /debts - List all debts
bot.onText(/\/debts/, async (msg) => {
  const chatId = msg.chat.id;
  
  try {
    const debts = await getDebts();
    
    if (debts.length === 0) {
      bot.sendMessage(chatId, '✅ Боргів немає!');
      return;
    }
    
    let message = '📋 <b>Список боргів:</b>\n\n';
    
    debts.forEach(debt => {
      const remain = debt.value - debt.paid;
      const percent = Math.round((debt.paid / debt.value) * 100);
      const emoji = percent === 100 ? '✅' : percent > 0 ? '🟡' : '🔴';
      
      message += `${emoji} <b>${debt.name}</b>\n`;
      message += `   Сума: ${formatMoney(debt.value)}\n`;
      message += `   Сплачено: ${formatMoney(debt.paid)} (${percent}%)\n`;
      message += `   Залишок: ${formatMoney(remain)}\n\n`;
    });
    
    bot.sendMessage(chatId, message, { parse_mode: 'HTML' });
  } catch (error) {
    bot.sendMessage(chatId, '❌ Помилка отримання списку боргів');
  }
});

// /total - Total debt
bot.onText(/\/total/, async (msg) => {
  const chatId = msg.chat.id;
  
  try {
    const debts = await getDebts();
    const totalDebt = debts.reduce((sum, d) => sum + d.value, 0);
    const totalPaid = debts.reduce((sum, d) => sum + d.paid, 0);
    const remaining = totalDebt - totalPaid;
    
    const message = `
💰 <b>Загальна сума</b>

📊 Всього боргів: ${formatMoney(totalDebt)}
✅ Сплачено: ${formatMoney(totalPaid)}
⏳ Залишилось: ${formatMoney(remaining)}
📈 Кількість боргів: ${debts.length}
`;
    
    bot.sendMessage(chatId, message, { parse_mode: 'HTML' });
  } catch (error) {
    bot.sendMessage(chatId, '❌ Помилка розрахунку');
  }
});

// /progress - Progress percentage
bot.onText(/\/progress/, async (msg) => {
  const chatId = msg.chat.id;
  
  try {
    const debts = await getDebts();
    const totalDebt = debts.reduce((sum, d) => sum + d.value, 0);
    const totalPaid = debts.reduce((sum, d) => sum + d.paid, 0);
    const percent = totalDebt > 0 ? Math.round((totalPaid / totalDebt) * 100) : 0;
    
    const progressBar = '▓'.repeat(Math.floor(percent / 10)) + '░'.repeat(10 - Math.floor(percent / 10));
    
    const message = `
📊 <b>Прогрес виплат</b>

${progressBar} ${percent}%

💰 Сплачено: ${formatMoney(totalPaid)}
⏳ Залишилось: ${formatMoney(totalDebt - totalPaid)}
`;
    
    bot.sendMessage(chatId, message, { parse_mode: 'HTML' });
  } catch (error) {
    bot.sendMessage(chatId, '❌ Помилка розрахунку прогресу');
  }
});

// /add - Add new debt
bot.onText(/\/add (.+) (\d+)/, async (msg, match) => {
  const chatId = msg.chat.id;
  const name = match[1].trim();
  const value = parseInt(match[2]);
  
  if (!name || value <= 0) {
    bot.sendMessage(chatId, '❌ Невірний формат.\nВикористання: /add Назва Сума\nПриклад: /add Кредит 5000');
    return;
  }
  
  try {
    await debtsRef.push({
      name: name,
      value: value,
      paid: 0,
      created: Date.now()
    });
    
    const message = `✅ <b>Борг додано</b>\n\nНазва: ${name}\nСума: ${formatMoney(value)}`;
    bot.sendMessage(chatId, message, { parse_mode: 'HTML' });
    
    // Notify all subscribers
    await notifyAll(`➕ <b>Новий борг додано</b>\n\nНазва: ${name}\nСума: ${formatMoney(value)}`);
  } catch (error) {
    bot.sendMessage(chatId, '❌ Помилка додавання боргу');
  }
});

// /pay - Pay part of debt
bot.onText(/\/pay (.+) (\d+)/, async (msg, match) => {
  const chatId = msg.chat.id;
  const name = match[1].trim();
  const amount = parseInt(match[2]);
  
  try {
    const debts = await getDebts();
    const debt = debts.find(d => d.name.toLowerCase() === name.toLowerCase());
    
    if (!debt) {
      bot.sendMessage(chatId, `❌ Борг "${name}" не знайдено`);
      return;
    }
    
    const newPaid = Math.min(debt.paid + amount, debt.value);
    const remain = debt.value - newPaid;
    
    await debtsRef.child(debt.id).update({ paid: newPaid });
    
    let message = `💰 <b>Оплату зараховано</b>\n\n`;
    message += `Борг: ${debt.name}\n`;
    message += `Сплачено: ${formatMoney(amount)}\n`;
    message += `Всього сплачено: ${formatMoney(newPaid)}\n`;
    message += `Залишок: ${formatMoney(remain)}`;
    
    if (newPaid === debt.value) {
      message += `\n\n🎉 <b>Борг повністю погашено!</b>`;
    }
    
    bot.sendMessage(chatId, message, { parse_mode: 'HTML' });
    
    // Notify all
    await notifyAll(message);
  } catch (error) {
    bot.sendMessage(chatId, '❌ Помилка оплати');
  }
});

// /delete - Delete debt
bot.onText(/\/delete (.+)/, async (msg, match) => {
  const chatId = msg.chat.id;
  const name = match[1].trim();
  
  try {
    const debts = await getDebts();
    const debt = debts.find(d => d.name.toLowerCase() === name.toLowerCase());
    
    if (!debt) {
      bot.sendMessage(chatId, `❌ Борг "${name}" не знайдено`);
      return;
    }
    
    await debtsRef.child(debt.id).remove();
    
    const message = `🗑️ <b>Борг видалено</b>\n\nНазва: ${debt.name}\nСума: ${formatMoney(debt.value)}`;
    bot.sendMessage(chatId, message, { parse_mode: 'HTML' });
    
    // Notify all
    await notifyAll(message);
  } catch (error) {
    bot.sendMessage(chatId, '❌ Помилка видалення');
  }
});

// /report - Full report
bot.onText(/\/report/, async (msg) => {
  const chatId = msg.chat.id;
  
  try {
    const debts = await getDebts();
    const balance = await getBalance();
    
    const totalDebt = debts.reduce((sum, d) => sum + d.value, 0);
    const totalPaid = debts.reduce((sum, d) => sum + d.paid, 0);
    const remaining = totalDebt - totalPaid;
    const percent = totalDebt > 0 ? Math.round((totalPaid / totalDebt) * 100) : 0;
    
    const completed = debts.filter(d => d.paid === d.value).length;
    const inProgress = debts.filter(d => d.paid > 0 && d.paid < d.value).length;
    const notStarted = debts.filter(d => d.paid === 0).length;
    
    let message = `
📊 <b>ПОВНИЙ ЗВІТ</b>

💰 <b>Баланс:</b> ${formatMoney(balance)}

📈 <b>Загальна статистика:</b>
• Всього боргів: ${debts.length}
• Загальна сума: ${formatMoney(totalDebt)}
• Сплачено: ${formatMoney(totalPaid)} (${percent}%)
• Залишилось: ${formatMoney(remaining)}

✅ <b>Статус боргів:</b>
• Погашено: ${completed}
• В процесі: ${inProgress}
• Не розпочато: ${notStarted}
`;
    
    if (debts.length > 0) {
      message += '\n📋 <b>Деталі:</b>\n';
      debts.forEach(debt => {
        const remain = debt.value - debt.paid;
        const p = Math.round((debt.paid / debt.value) * 100);
        const emoji = p === 100 ? '✅' : p > 0 ? '🟡' : '🔴';
        message += `\n${emoji} ${debt.name}: ${formatMoney(remain)} (${p}%)`;
      });
    }
    
    bot.sendMessage(chatId, message, { parse_mode: 'HTML' });
  } catch (error) {
    bot.sendMessage(chatId, '❌ Помилка створення звіту');
  }
});

// /stats - Statistics
bot.onText(/\/stats/, async (msg) => {
  const chatId = msg.chat.id;
  
  try {
    const debts = await getDebts();
    
    if (debts.length === 0) {
      bot.sendMessage(chatId, '📊 Немає даних для статистики');
      return;
    }
    
    const totalDebt = debts.reduce((sum, d) => sum + d.value, 0);
    const avgDebt = totalDebt / debts.length;
    const maxDebt = Math.max(...debts.map(d => d.value));
    const minDebt = Math.min(...debts.map(d => d.value));
    const maxDebtName = debts.find(d => d.value === maxDebt)?.name;
    const minDebtName = debts.find(d => d.value === minDebt)?.name;
    
    const message = `
📈 <b>СТАТИСТИКА</b>

📊 <b>Загальна інформація:</b>
• Кількість боргів: ${debts.length}
• Середній борг: ${formatMoney(Math.round(avgDebt))}

💰 <b>Екстремуми:</b>
• Найбільший: ${maxDebtName} (${formatMoney(maxDebt)})
• Найменший: ${minDebtName} (${formatMoney(minDebt)})
`;
    
    bot.sendMessage(chatId, message, { parse_mode: 'HTML' });
  } catch (error) {
    bot.sendMessage(chatId, '❌ Помилка розрахунку статистики');
  }
});

